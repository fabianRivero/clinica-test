#!/bin/bash
# ============================================
# Deploy script — Clínica Estética
# Genérico para cualquier VPS Linux
# ============================================
#
# Uso:
#   1. Copiá este archivo: cp scripts/deploy.sh.example scripts/deploy.sh
#   2. La primera vez te pregunta los datos del VPS y los guarda en
#      scripts/.deploy-config (no se commitea).
#   3. Ejecutá: ./scripts/deploy.sh
#
# Variables de entorno reconocidas:
#   - BIOMETRIC_SUSPENDED: backend flag (default: 1, suspende las
#     mutaciones biometricas). Para rollback: BIOMETRIC_SUSPENDED=0.
#   - VITE_BIOMETRIC_SUSPENDED: frontend build flag (default: true
#     cuando la respuesta al ask_once es "1"; false cuando es "0").
#     Debe matchear BIOMETRIC_SUSPENDED — el script los levanta juntos.
#   - VPS_*, PROJECT_PATH, GIT_BRANCH, DOMAIN, GIT_REPO: iguales que
#     antes.
#
# Ejecutables verificados (con `cat <<SSHEOF` para simular el SSH):
#   Forward:  ./scripts/deploy.sh
#             -> BIOMETRIC_SUSPENDED=1, VITE_BIOMETRIC_SUSPENDED=true
#   Rollback: BIOMETRIC_SUSPENDED=0 VITE_BIOMETRIC_SUSPENDED=false \
#             ./scripts/deploy.sh
#             -> BIOMETRIC_SUSPENDED=0, VITE_BIOMETRIC_SUSPENDED=false
#
# El script se conecta por SSH al VPS, baja los últimos cambios de Git,
# instala dependencias, aplica migraciones, reconstruye el frontend y
# reinicia Gunicorn.
#
# ============================================
# OpenSpec `suspend-fingerprint-integration` — rollout notes
# ============================================
# El backend expone `BIOMETRIC_SUSPENDED` en `backend/.env`. Mientras
# esté en `1`, los ENDPOINTS DE MUTACIÓN biometricos devuelven HTTP
# 503 con código `BIOMETRIC_SUSPENDED`. Los GETs administrativos
# (listado de agentes, historial) siguen funcionando por diseño.
# El frontend construido con `VITE_BIOMETRIC_SUSPENDED=true` oculta
# todos los controles de huella y no emite ninguna request
# `/api/biometric/*`. El backend siempre es autoritativo: si los
# flags divergen, gana el 503 del backend.
#
# === Orden del deploy (backend-first, frontend-second) ===
# Bloque SSH ejecuta en este orden:
#   1. git pull
#   2. pip install
#   3. Activar flag backend (sed/append en backend/.env).
#   4. Reiniciar Gunicorn.
#   5. Validar backend con un endpoint gateado (ver bloque
#      "Validación ejecutable" más abajo). Aborta el deploy si falla.
#   6. Build frontend con `VITE_BIOMETRIC_SUSPENDED=${VAR:-true}`.
#   7. Migraciones + collectstatic + nginx check.
# Los pasos 3-5 son los que materializan la suspensión antes de
# servir el bundle.
#
# === Validación ejecutable (forward: flag=true) ===
# Requiere un admin logueado (cookie de sesión + CSRF). El endpoint
# gateado es POST /api/biometric/citas/<id>/huella/verify-init/
# (los GET a /api/biometric/agents/ NO se gatean por diseño, por lo
# que NO sirven para validar). Reemplazar <id> por una cita real
# en estado REALIZADA_PENDIENTE_VERIFICACION.
#
#   # Forward (esperado: 503 + BIOMETRIC_SUSPENDED)
#   curl -sS -i -X POST \
#       -b "$COOKIE_JAR" -H "X-CSRFToken: $CSRF" \
#       -H "Origin: https://$DOMAIN" -H "Referer: https://$DOMAIN/" \
#       "https://$DOMAIN/api/biometric/citas/<id>/huella/verify-init/" \
#       | head -1
#   # -> HTTP/1.1 503 Service Unavailable
#   curl -sS -X POST \
#       -b "$COOKIE_JAR" -H "X-CSRFToken: $CSRF" \
#       -H "Origin: https://$DOMAIN" -H "Referer: https://$DOMAIN/" \
#       "https://$DOMAIN/api/biometric/citas/<id>/huella/verify-init/"
#   # -> {"detail":"...","code":"BIOMETRIC_SUSPENDED",...}
#
# === Rollback / re-enable ejecutable ===
# El flag está horneado en el bundle — el rebuild es OBLIGATORIO.
# Forward y rollback son ejecutables:
#
#   # Forward (esperado: 1 + true):
#   ./scripts/deploy.sh
#
#   # Rollback (esperado: 0 + false):
#   BIOMETRIC_SUSPENDED=0 VITE_BIOMETRIC_SUSPENDED=false ./scripts/deploy.sh
#
# === Servicios del lector DigitalPersona 4500 (operador) ===
# ESTOS COMANDOS NO SE EJECUTAN DESDE ESTE SCRIPT — el script apunta
# al VPS de la aplicación; el lector físico vive en la PC de
# recepción. Repo evidence (fingerprint-agent/systemd/): la unidad
# cloudflared.service está dedicada exclusivamente al agente de
# huella (`Description=Cloudflare Tunnel for the clinic fingerprint
# agent`), por lo que deshabilitarla es seguro dentro de este alcance.
# Las unidades, archivos, configuración, credenciales y logs quedan
# intactos (`disable --now` no borra nada).
#
#   # Operador, en la PC del lector (forward):
#   sudo systemctl is-enabled fingerprint-agent || true
#   sudo systemctl is-active  fingerprint-agent || true
#   sudo systemctl disable --now fingerprint-agent
#   sudo systemctl disable --now cloudflared
#   sudo systemctl status fingerprint-agent --no-pager || true
#
#   # Operador, en la PC del lector (rollback):
#   sudo systemctl enable --now fingerprint-agent
#   sudo systemctl enable --now cloudflared
#   sudo systemctl status fingerprint-agent --no-pager

set -e

# ============================================
# CONFIGURACIÓN — la primera vez se piden al usuario
# ============================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/.deploy-config"

# Cargar config guardada si existe
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

# Defaults (se usan si la config no tiene el valor)
VPS_USER="${VPS_USER:-deploy}"
PROJECT_PATH="${PROJECT_PATH:-/var/www/clinica}"
GIT_BRANCH="${GIT_BRANCH:-main}"

# ============================================
# HELPERS
# ============================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_step()  { echo -e "${GREEN}[STEP]${NC} $1"; }
log_error()  { echo -e "${RED}[ERROR]${NC} $1"; }
log_warn()   { echo -e "${YELLOW}[WARN]${NC} $1"; }

# ask_once VAR "Pregunta" [default]
# Si VAR está vacío, pregunta al usuario. Lo que responda queda en la config.
ask_once() {
    local var_name="$1"
    local prompt="$2"
    local default="$3"
    local current_value="${!var_name}"

    # Si ya hay valor, usarlo
    if [ -n "$current_value" ]; then
        return 0
    fi

    # Si hay default y estamos en un terminal no interactivo, usarlo
    if [ -n "$default" ] && [ ! -t 0 ]; then
        printf -v "$var_name" "%s" "$default"
        eval "$var_name=\"$default\""
        save_config
        return 0
    fi

    # Preguntar al usuario
    local answer
    if [ -n "$default" ]; then
        read -rp "$prompt [$default]: " answer
    else
        read -rp "$prompt: " answer
    fi

    answer="${answer:-$default}"

    if [ -z "$answer" ]; then
        log_error "El campo '$var_name' es obligatorio."
        exit 1
    fi

    eval "$var_name=\"\$answer\""
    save_config
}

save_config() {
    cat > "$CONFIG_FILE" <<EOF
# Generado por deploy.sh — no editar a mano
VPS_HOST="$VPS_HOST"
VPS_USER="$VPS_USER"
PROJECT_PATH="$PROJECT_PATH"
DOMAIN="$DOMAIN"
GIT_BRANCH="$GIT_BRANCH"
GIT_REPO="$GIT_REPO"
BIOMETRIC_SUSPENDED="$BIOMETRIC_SUSPENDED"
VITE_BIOMETRIC_SUSPENDED="$VITE_BIOMETRIC_SUSPENDED"
EOF
    chmod 600 "$CONFIG_FILE"
}

# ============================================
# PEDIR VALORES FALTANTES
# ============================================
ask_once VPS_HOST "IP o hostname del VPS" ""
ask_once PROJECT_PATH "Path del proyecto en el VPS" "/var/www/clinica"
ask_once VPS_USER "Usuario SSH en el VPS" "deploy"
ask_once DOMAIN "Dominio principal (sin https://)" ""
ask_once GIT_BRANCH "Rama a desplegar" "main"
ask_once GIT_REPO "URL del repo (para validar el remote)" ""
# Flag backend. `1` = suspender mutaciones biometricas (forward,
#   usado durante el rollout de suspend-fingerprint-integration).
# `0` = estado normal de producción hoy (default).
#   Para hacer forward en nuevas rondas de suspensión:
#     BIOMETRIC_SUSPENDED=1 ./scripts/deploy.sh
#   Para rollback:
#     BIOMETRIC_SUSPENDED=0 ./scripts/deploy.sh
ask_once BIOMETRIC_SUSPENDED "BIOMETRIC_SUSPENDED (1=forward, 0=produccion)" "0"
# Flag frontend. Se inicializa desde BIOMETRIC_SUSPENDED para que
# ambos flags se muevan juntos; se puede sobreescribir pasando
# VITE_BIOMETRIC_SUSPENDED=... antes de invocar el script.
VITE_BIOMETRIC_SUSPENDED="${VITE_BIOMETRIC_SUSPENDED:-$( [ "$BIOMETRIC_SUSPENDED" = "1" ] && echo true || echo false )}"

# ============================================
# VALIDACIONES
# ============================================
if [ ! -f ".git/config" ]; then
    log_error "No estás en un repositorio git. Ejecutá el script desde la raíz del proyecto."
    exit 1
fi

# Flag sanity check: ambos flags deben ser coherentes. Si el operador
# los pasa explícitamente y difieren, loguear un warning (no abortar
# porque podría ser un deploy de testing).
if [ "$BIOMETRIC_SUSPENDED" = "1" ] && [ "$VITE_BIOMETRIC_SUSPENDED" != "true" ]; then
    log_warn "BIOMETRIC_SUSPENDED=1 pero VITE_BIOMETRIC_SUSPENDED=$VITE_BIOMETRIC_SUSPENDED — el backend será autoritativo."
fi

if [ -n "$GIT_REPO" ]; then
    CURRENT_REMOTE=$(git remote get-url origin 2>/dev/null || echo "")
    if [ "$CURRENT_REMOTE" != "$GIT_REPO" ]; then
        log_warn "El remote 'origin' no coincide con GIT_REPO"
        echo "  Esperado: $GIT_REPO"
        echo "  Actual:   $CURRENT_REMOTE"
        read -rp "¿Continuar de todos modos? (s/n): " -n 1
        echo
        if [[ ! $REPLY =~ ^[Ss]$ ]]; then
            exit 1
        fi
    fi
fi

# ============================================
# DEPLOY
# ============================================
log_step "Iniciando deploy a $VPS_USER@$VPS_HOST (rama: $GIT_BRANCH)..."
log_step "BIOMETRIC_SUSPENDED=$BIOMETRIC_SUSPENDED VITE_BIOMETRIC_SUSPENDED=$VITE_BIOMETRIC_SUSPENDED"

ssh "$VPS_USER@$VPS_HOST" << SSHEOF
set -e

PROJECT_PATH="$PROJECT_PATH"
GIT_BRANCH="$GIT_BRANCH"
BIOMETRIC_SUSPENDED="$BIOMETRIC_SUSPENDED"
VITE_BIOMETRIC_SUSPENDED="$VITE_BIOMETRIC_SUSPENDED"
DOMAIN="$DOMAIN"

echo "=== 1. Pull últimos cambios ==="
cd "\$PROJECT_PATH"
sudo -u www-data git pull origin "\$GIT_BRANCH"

echo "=== 2. Dependencias Python ==="
cd backend
sudo -u www-data env/bin/pip install -q -r requirements.txt
cd ..

echo "=== 3. Activar flag backend en backend/.env ==="
# Edita / hace append de BIOMETRIC_SUSPENDED en backend/.env. Si el
# operador ya tiene el valor deseado (mismo valor), el sed es
# no-op. Si difiere, actualiza in-place.
ENV_FILE="\$PROJECT_PATH/backend/.env"
if [ -n "\$BIOMETRIC_SUSPENDED" ]; then
    if [ -f "\$ENV_FILE" ] && grep -qE "^BIOMETRIC_SUSPENDED=" "\$ENV_FILE"; then
        sudo -u www-data sed -i "s/^BIOMETRIC_SUSPENDED=.*/BIOMETRIC_SUSPENDED=\$BIOMETRIC_SUSPENDED/" "\$ENV_FILE"
    else
        sudo -u www-data bash -c "echo 'BIOMETRIC_SUSPENDED=\$BIOMETRIC_SUSPENDED' >> \$ENV_FILE"
    fi
    echo "  -> BIOMETRIC_SUSPENDED=\$BIOMETRIC_SUSPENDED aplicado a backend/.env"
fi

echo "=== 4. Reiniciar Gunicorn ==="
sudo systemctl restart gunicorn
sleep 2

echo "=== 5. Validación gateada (POST /api/biometric/citas/<id>/huella/verify-init/) ==="
# Prerrequisito: una CitaMedica en estado REALIZADA_PENDIENTE_VERIFICACION.
# Si no existe, la validación cae a 404 (CITA_NOT_FOUND) — el operador
# debe crear una o ajustar CITA_ID_REMOTA abajo.
# Las requests GET a /api/biometric/agents/ NO se gatean por diseño, por
# lo que NO sirven para validar.
CITA_ID_REMOTA="\${CITA_ID_REMOTA:-1}"
COOKIE_JAR_REMOTA="\${COOKIE_JAR_REMOTA:-/tmp/clinica-deploy-cookie}"
if [ -f "\$COOKIE_JAR_REMOTA" ]; then
    CSRF=\$(sudo -u www-data cat "\$COOKIE_JAR_REMOTA" | grep csrftoken | awk '{print \$NF}')
    DOMAIN="\${DOMAIN_REMOTA:-\$DOMAIN}"
    ORIGIN="https://\$DOMAIN"
    RESP=\$(curl -sS -o /tmp/clinica-suspend-resp.json -w "%{http_code}" -X POST \
        -b "\$COOKIE_JAR_REMOTA" -H "X-CSRFToken: \$CSRF" \
        -H "Origin: \$ORIGIN" -H "Referer: \$ORIGIN/" \
        "http://127.0.0.1:8000/api/biometric/citas/\$CITA_ID_REMOTA/huella/verify-init/")
    echo "  HTTP \$RESP"
    cat /tmp/clinica-suspend-resp.json 2>/dev/null || true
    echo ""
    if [ "\$BIOMETRIC_SUSPENDED" = "1" ]; then
        # Forward: esperamos 503 + BIOMETRIC_SUSPENDED.
        if [ "\$RESP" = "503" ]; then
            echo "  -> OK: gate activo, 503 BIOMETRIC_SUSPENDED"
        else
            echo "  -> ERROR: forward fallo, gate no devolvio 503 (esperado 503, recibio \$RESP)."
            echo "     Si la respuesta es 401, falta cookie/CSRF o CITA_ID_REMOTA."
            echo "     Si la respuesta es 404, falta una CitaMedica en REALIZADA_PENDIENTE_VERIFICACION."
            exit 1
        fi
    else
        # Rollback: esperamos 200 o 4xx de estado, NO 503.
        if [ "\$RESP" = "503" ]; then
            echo "  -> ERROR: rollback fallo, gate todavia activo"
            exit 1
        else
            echo "  -> OK: gate inactivo, respuesta \$RESP"
        fi
    fi
else
    echo "  -> SKIP: cookie jar no presente en \$COOKIE_JAR_REMOTA"
    echo "     Para habilitar la validación, generar el cookie jar con:"
    echo "     curl -c \$COOKIE_JAR_REMOTA -X POST ... /api/auth/login/ ..."
fi

echo "=== 6. Build frontend ==="
# Build-time flag: el valor definido en este shell (forward=true,
# rollback=false) se exporta en la línea de SSH para garantizar que
# llega al subproceso de build. El bundle queda horneado con ese
# valor — toggles posteriores requieren rebuild.
cd frontend/aesthetic-clinic
sudo -u www-data npm ci
sudo -u www-data env "VITE_BIOMETRIC_SUSPENDED=\${VITE_BIOMETRIC_SUSPENDED:-true}" npm run build
cd ../..

echo "=== 7. Migraciones ==="
sudo -u www-data "\$PROJECT_PATH/backend/env/bin/python" "\$PROJECT_PATH/backend/manage.py" migrate --noinput

echo "=== 8. Static files ==="
sudo -u www-data "\$PROJECT_PATH/backend/env/bin/python" "\$PROJECT_PATH/backend/manage.py" collectstatic --noinput

echo "=== 9. Verificar Nginx ==="
sudo nginx -t

echo ""
echo "=== Deploy remoto completado ==="
SSHEOF

# ============================================
# VERIFICACIÓN POST-DEPLOY
# ============================================
if [ -n "$DOMAIN" ]; then
    log_step "Verificando que el sitio responda..."
    sleep 2
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" "https://$DOMAIN/" || echo "000")
    if [ "$HTTP_CODE" = "200" ]; then
        log_step "Sitio responde OK (HTTP 200)"
    else
        log_error "El sitio no responde correctamente (HTTP $HTTP_CODE)"
        log_warn "Verificá manualmente: https://$DOMAIN"
    fi
fi

echo ""
log_step "Deploy finalizado."
echo "  Rama desplegada: $GIT_BRANCH"
echo "  SHA local:       $(git rev-parse HEAD 2>/dev/null || echo '(no se pudo leer)')"
echo "  BIOMETRIC_SUSPENDED=$BIOMETRIC_SUSPENDED VITE_BIOMETRIC_SUSPENDED=$VITE_BIOMETRIC_SUSPENDED"
