# ============================================
# Backend .env — Clínica Estética
# ============================================
#
# Copiá este archivo a `.env` y completá los valores:
#   cp .env.example .env
#   nano .env
#
# NUNCA commitees el `.env` real al repo (está en .gitignore).
# Después de cambiar cualquier valor acá, reiniciá Gunicorn:
#   sudo systemctl restart gunicorn
#
# Cómo generar DJANGO_SECRET_KEY:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# ============================================
# Seguridad Django
# ============================================
DJANGO_SECRET_KEY=REEMPLAZAR-POR-KEY-DE-50-CARACTERES
DJANGO_DEBUG=0
# Lista separada por comas. Incluí tu dominio con y sin www.
DJANGO_ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# ============================================
# Base de datos PostgreSQL
# ============================================
# Producción: usar DB_ENGINE=postgres y dejar DJANGO_USE_LOCAL_DB=False
# Desarrollo local: poner DJANGO_USE_LOCAL_DB=True para usar SQLite
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=clinica
DJANGO_DB_USER=clinica_app
DJANGO_DB_PASSWORD=REEMPLAZAR-POR-PASSWORD-DE-LA-DB
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=prefer

# Poner en True SOLO para desarrollo local (usa SQLite en db.sqlite3).
# En producción SIEMPRE False.
DJANGO_USE_LOCAL_DB=False

# ============================================
# Cookies y CORS
# ============================================
# Orígenes permitidos para CORS (frontend). Lista separada por comas.
DJANGO_CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Orígenes confiables para CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Cookies seguras (solo se envían por HTTPS). En producción SIEMPRE 1.
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_HTTPONLY=0
DJANGO_SESSION_COOKIE_SECURE=1

# ============================================
# Almacenamiento de archivos (media: QR, PDFs, recibos)
# ============================================
# Opciones:
#   "local"    — guarda en backend/media/ (default, ok para empezar)
#   "supabase" — guarda en Supabase Storage
#   "s3"       — guarda en S3 o compatible (DO Spaces, Backblaze, MinIO, etc.)
STORAGE_PROVIDER=local

# --- Solo si STORAGE_PROVIDER=supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# --- Solo si STORAGE_PROVIDER=s3 ---
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=
