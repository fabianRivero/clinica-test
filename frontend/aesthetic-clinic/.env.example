# Frontend environment example.
# Copy to `.env` (gitignored) and fill in real values for local dev.

# ----------------------------------------------------------------------
# Backend base URL
# ----------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------
# DP4500 host-app ServiceAPIKey — Bearer credential for /api/biometric/service/*
# ----------------------------------------------------------------------
# Get one via:
#   python manage.py create_service_api_key --name aesthetic-clinic-dev
# Raw token is shown ONCE at creation. Keep this out of git (.env is
# gitignored); share via your team's secret manager, never via PR.
VITE_DP4500_SERVICE_API_KEY=
