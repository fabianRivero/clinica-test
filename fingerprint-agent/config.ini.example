# Clinic fingerprint agent configuration.
#
# Copy to /etc/fingerprint-agent/config.ini and chmod 600:
#   sudo cp config.ini.example /etc/fingerprint-agent/config.ini
#   sudo chown fingerprint-agent:fingerprint-agent /etc/fingerprint-agent/config.ini
#   sudo chmod 600 /etc/fingerprint-agent/config.ini
#
# The raw_token is generated by the backend once per agent via
# POST /api/biometric/agents/. It is the only secret in this file; do
# not commit it.

[server]
# Listen on localhost only. Public access is via Cloudflare Tunnel.
bind = 127.0.0.1:8765
log_level = INFO
# Username used by fprintd to associate the device claim with the agent.
# Any string works; pick something distinctive to spot on the lock screen.
fingerprint_username = fingerprint-agent

[auth]
# Raw bearer token. The backend stores sha256(token) on the AgentToken
# row and uses the same hash for incoming heartbeat auth. This file is
# the ONLY place the raw token is held — keep it chmod 600.
raw_token = REPLACE_WITH_RAW_TOKEN_FROM_BACKEND

[backend]
# Public URL of the Django backend. Used by the heartbeat client.
# Leave api_base empty to disable the outbound heartbeat loop.
api_base = https://reactproject.site
agent_id = 1
heartbeat_interval_seconds = 60

[device]
# Substring matched against fprintd's device name. Defaults to "4500"
# which matches the DigitalPersona U.are.U 4000/4000B/4500 series.
name_match = 4500
# Max time (seconds) to wait for an enroll to complete.
enroll_timeout_seconds = 60
# Max time (seconds) to wait for a verify to complete.
# Defaults to 120 so the operator always has plenty of time to place
# a finger. Slow readers or cold-platen scenarios sometimes need 30-60s
# to register a contact; the previous default of 30 was too tight.
verify_timeout_seconds = 120
